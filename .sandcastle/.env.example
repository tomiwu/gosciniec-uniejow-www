# Copy to .sandcastle/.env (mode 600). Never commit .sandcastle/.env.
# Fine-grained PAT for tomiwu/gosciniec-uniejow-www only: Contents, Issues, Pull requests, Workflows, Administration (read/write).
GH_TOKEN=
# Claude Code (the loop agent).
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-sonnet-5-5
# Cursor CLI (local fallback agent when Claude reaches its limit, issue #58). Empty: no fallback.
# The loop and scripts/ux-review.sh read it. Never use Cursor cloud agents.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
UX_REVIEW_CURSOR_MODEL=grok-4.7-high
PROJECT=gosciniec-uniejow-www
STATUS_FILE=/tmp/gosciniec-www-loop.status.json
# Loop events webhook: NOT here. Put LOOP_WEBHOOK_URL and LOOP_WEBHOOK_KEY in
# /workspace/gosciniec-www-secrets/loop-webhook.env (mode 600). scripts/start-loop.sh reads it.
# Reason: Sandcastle copies every key of this file into the agent container.
MAX_ITERATIONS=30
