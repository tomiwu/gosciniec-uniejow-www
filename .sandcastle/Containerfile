# Sandcastle image for gosciniec-uniejow-www.
# Contains every CI tool: Node LTS, git, gh, Claude Code, Cursor CLI, Playwright Chromium (+ system deps).
# Lighthouse CI uses the same Chromium (CHROME_PATH). PHP CLI lints public/api/contact.php.
FROM docker.io/library/node:26-bookworm-slim

RUN apt-get -o Acquire::Retries=5 update && apt-get install -y --no-install-recommends \
  git curl jq ca-certificates php-cli \
  && rm -rf /var/lib/apt/lists/*

# GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  > /etc/apt/sources.list.d/github-cli.list \
  && apt-get -o Acquire::Retries=5 update && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# Playwright Chromium in a shared path. The version must match @playwright/test in package.json.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ARG PLAYWRIGHT_VERSION=1.65.1
RUN npx -y playwright@${PLAYWRIGHT_VERSION} install --with-deps chromium \
  && rm -rf /var/lib/apt/lists/* /root/.npm \
  && chmod -R a+rX /ms-playwright \
  && ln -s "$(ls -d /ms-playwright/chromium-*/chrome-linux*/chrome | head -1)" /usr/local/bin/chromium
ENV CHROME_PATH=/usr/local/bin/chromium

# Claude Code CLI (the loop agent)
ARG CLAUDE_CODE_VERSION=2.1.332
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} && rm -rf /root/.npm

ARG AGENT_UID=1000
ARG AGENT_GID=1000
RUN groupmod -o -g $AGENT_GID node && usermod -o -u $AGENT_UID -g $AGENT_GID -d /home/agent -m -l agent node \
  && chmod -R a+rwX /home/agent && chmod 1777 /tmp
USER ${AGENT_UID}:${AGENT_GID}
WORKDIR /home/agent

# Cursor CLI (`agent`): the fallback agent when Claude reaches its limit (issue #58).
# Local CLI only. Never Cursor cloud agents. It needs CURSOR_API_KEY in .sandcastle/.env.
ENV HOME=/home/agent
RUN curl -fsSL https://cursor.com/install | bash && /home/agent/.local/bin/agent --version
ENV PATH=/home/agent/.local/bin:$PATH
ENTRYPOINT ["sleep", "infinity"]
